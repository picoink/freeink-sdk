# FreeInk PAN on the Arduino 4.0 RC1 / IDF 6.1 S31 baseline
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
# Keep internal RAM available for the controller, network buffers and display.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
# Keep the controller on the standard internal-memory path. Its experimental
# SPIRAM option is unnecessary once display queues leave the DMA heap.
CONFIG_BT_CTRL_ALLOW_MALLOC_FROM_SPIRAM=n
# The product supports one phone PAN link and one BLE page turner at a time.
CONFIG_BT_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BT_LE_MAX_CONNECTIONS=1
CONFIG_BT_LE_CONN_RESERVED_MEMORY_COUNT=1
CONFIG_BT_LE_EXT_ADV_RESERVED_MEMORY_COUNT=0
# Bound BLE queues for the single HID connection; Classic PAN keeps its own
# ACL buffers. Preserve packet sizes and extended scanning support.
CONFIG_BT_LE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_LE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_LE_ACL_BUF_COUNT=8
CONFIG_BT_LE_HCI_EVT_HI_BUF_COUNT=12
CONFIG_BT_LE_HCI_EVT_LO_BUF_COUNT=4
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_PAN_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_SSP_ENABLED=y
CONFIG_BT_A2DP_ENABLE=n
CONFIG_BT_SPP_ENABLED=n
CONFIG_BT_HFP_ENABLE=n
CONFIG_BT_HID_ENABLED=n
CONFIG_ENABLE_CHIPOBLE=n
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_TINYUSB_ENABLED=y
CONFIG_TINYUSB_MSC_ENABLED=y
# The reader exposes CDC and MSC only. Unused classes otherwise reserve tens
# of KiB of internal endpoint/FIFO memory before Bluetooth can even start.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_MAX_PORTS=1
CONFIG_TINYUSB_HOST_ENABLED=n
CONFIG_TINYUSB_HID_ENABLED=n
CONFIG_TINYUSB_MIDI_ENABLED=n
CONFIG_TINYUSB_AUDIO_ENABLED=n
CONFIG_TINYUSB_VIDEO_ENABLED=n
CONFIG_TINYUSB_DFU_RT_ENABLED=n
CONFIG_TINYUSB_DFU_ENABLED=n
CONFIG_TINYUSB_VENDOR_ENABLED=n
CONFIG_TINYUSB_NCM_ENABLED=n

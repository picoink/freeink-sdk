+
+#define BTC_PAN_APP_ID_PANU     0
+#define BTC_PAN_APP_ID_NAP      1
+#define BTC_PAN_APP_ID_GN       2
+
+typedef enum {
+    BTC_PAN_ACT_INIT = 0,
+    BTC_PAN_ACT_DEINIT,
+    BTC_PAN_ACT_CONNECT,
+    BTC_PAN_ACT_DISCONNECT,
+    BTC_PAN_ACT_WRITE,
+    BTC_PAN_ACT_SET_PFILTER,
+    BTC_PAN_ACT_SET_MFILTER,
+} btc_pan_act_t;
+
+typedef union {
+    struct pan_init_arg {
+        esp_pan_cfg_t cfg;
+    } init;
+
+    struct pan_connect_arg {
+        BD_ADDR bd_addr;
+        esp_pan_role_t local_role;
+        esp_pan_role_t peer_role;
+    } connect;
+
+    struct pan_disconnect_arg {
+        uint16_t handle;
+    } disconnect;
+
+    struct pan_write_arg {
+        uint16_t handle;
+        esp_pan_mac_addr_t dst;
+        esp_pan_mac_addr_t src;
+        uint16_t protocol;
+        uint16_t len;
+        uint8_t *data;
+        bool ext;
+    } write;
+
+    struct pan_set_pfilter_arg {
+        uint16_t handle;
+        uint16_t num_filters;
+        const uint16_t *start_array;
+        const uint16_t *end_array;
+    } set_pfilter;
+
+    struct pan_set_mfilter_arg {
+        uint16_t handle;
+        uint16_t num_filters;
+        const esp_pan_mac_addr_t *start_array;
+        const esp_pan_mac_addr_t *end_array;
+    } set_mfilter;
+} btc_pan_args_t;
+
+typedef struct {
+    bool inited;
+    esp_pan_cfg_t cfg;
+    uint16_t conn_hdl[BTA_PAN_NUM_CONN];
+} btc_pan_local_param_t;
+
+#if PAN_DYNAMIC_MEMORY == TRUE
+extern btc_pan_local_param_t *btc_pan_local_param_ptr;
+#define btc_pan_local_param (*btc_pan_local_param_ptr)
+#endif
+
+void btc_pan_free_cfg_strings(void);
+void btc_pan_call_handler(btc_msg_t *msg);
+void btc_pan_cb_handler(btc_msg_t *msg);
+void btc_pan_get_profile_status(esp_pan_profile_status_t *param);
+void btc_pan_arg_deep_copy(btc_msg_t *msg, void *p_dest, void *p_src);
+void btc_pan_arg_deep_free(btc_msg_t *msg);
+void btc_pan_cb_deep_copy(btc_msg_t *msg, void *p_dest, void *p_src);
+void btc_pan_cb_deep_free(btc_msg_t *msg);
+
+void btc_pan_co_data_ind(UINT16 handle, BD_ADDR src, BD_ADDR dst, UINT16 protocol,
+                         UINT8 *p_data, UINT16 len, BOOLEAN ext, BOOLEAN forward);
+void btc_pan_co_rx_flow(UINT16 handle, BOOLEAN enable);
+void btc_pan_co_pfilt_ind(UINT16 handle, BOOLEAN indication, tBTA_PAN_STATUS result,
+                          UINT16 len, UINT8 *p_filters);
+void btc_pan_co_mfilt_ind(UINT16 handle, BOOLEAN indication, tBTA_PAN_STATUS result,
+                          UINT16 len, UINT8 *p_filters);
+
+#endif /* BTC_PAN_INCLUDED */

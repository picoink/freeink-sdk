+/******************************************************************************
+ *
+ *  This file contains the PAN main functions and state machine.
+ *
+ ******************************************************************************/
+
+#include "common/bt_target.h"
+
+#if (BTA_PAN_INCLUDED == TRUE)
+
+#include <string.h>
+
+#include "bt_common.h"
+#include "bta/bta_api.h"
+#include "bta/bta_pan_api.h"
+#include "bta_pan_int.h"
+#include "bta/bta_sys.h"
